/* Mac Classic launcher — matches waybar chrome (#c0c0c0, Chicago Kare, sharp corners) */

* {
    bg:         #c0c0c0;
    bg-alt:     #d0d0d0;
    bg-pressed: #b0b0b0;
    fg:         #000000;
    border-dk:  #404040;
    hi-light:   #ffffff;
    hi-dark:    #808080;
    select-bg:  #7DAEA3;

    background-color: transparent;
    text-color:       @fg;
    font:             "Chicago Kare 13";
}

window {
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-dk;
    border-radius:    0;
    padding:          0;
    width:            420px;
    location:         northwest;
    anchor:           northwest;
    x-offset:         4px;
    y-offset:         24px;
    children:         [ mainbox ];
}

mainbox {
    background-color: transparent;
    padding:          4px;
    spacing:          4px;
    children:         [ inputbar, listview ];
}

/* Search field — flat inset look (rasi doesn't support per-side border colors) */
inputbar {
    background-color: #ffffff;
    padding:          4px 6px;
    border:           1px solid;
    border-color:     @hi-dark;
    border-radius:    0;
    spacing:          6px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @fg;
    background-color: transparent;
}

entry {
    text-color:         @fg;
    background-color:   transparent;
    placeholder:        "Search…";
    placeholder-color:  @hi-dark;
    cursor:             text;
}

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    spacing:          1px;
    fixed-height:     true;
    dynamic:          true;
    scrollbar:        false;
    cycle:            true;
}

element {
    padding:          3px 6px;
    background-color: transparent;
    text-color:       @fg;
    border-radius:    0;
    border:           0;
    spacing:          8px;
    cursor:           pointer;
}

element selected {
    background-color: @select-bg;
    text-color:       @fg;
}

element-icon {
    size:             18px;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
